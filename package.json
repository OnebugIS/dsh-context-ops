{
  "name": "dsh-context-ops",
  "version": "0.1.5",
  "description": "DSH 上下文运维插件：交接技能 + 上下文决策/诊断技能 + 压力读数工具（含窗口证据来源）+ 斜杠命令。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["lib", "locale", "assets", "icon.svg", "cordis.patch.yml", "README.md", "README.en.md", "CHANGELOG.md", "LICENSE"],
  "scripts": { "test": "node --test" },
  "engines": { "node": ">=20" },
  "keywords": ["deepseek-harness","dsh","dsh-plugin","context","compaction","handover","skill"],
  "license": "MIT",
  "author": "廷宇",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OnebugIS/dsh-context-ops.git"
  },
  "homepage": "https://github.com/OnebugIS/dsh-context-ops#readme",
  "bugs": {
    "url": "https://github.com/OnebugIS/dsh-context-ops/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
}
